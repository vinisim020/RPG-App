// Gaia: O Preludio — ferramenta de mesa
// Uma campanha unica; jogadores podem ter varios personagens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  MESTRE
  JOGADOR
}

model Usuario {
  id          String       @id @default(cuid())
  nome        String
  login       String       @unique
  senhaHash   String
  papel       Papel        @default(JOGADOR)
  criadoEm    DateTime     @default(now())
  personagens Personagem[]
}

// ---------------------------------------------------------------- Personagem

model Personagem {
  id        String  @id @default(cuid())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  nome           String
  jogadorNome    String  @default("")
  legado         String  @default("")
  nivelDespertar Int     @default(1)
  retratoUrl     String?

  movimentacao     String @default("")
  bloqueio         String @default("")
  percepcaoPassiva String @default("")

  pvAtual  Int @default(0)
  pvTemp   Int @default(0)
  pvMax    Int @default(0)
  peAtual  Int @default(0)
  peTemp   Int @default(0)
  peMax    Int @default(0)
  exaustao Int @default(0) // 0 a 5

  moedasPrata      Int @default(0)
  moedasOuro       Int @default(0)
  moedasImperiais  Int @default(0)
  potencia         Int @default(0)
  pontuacaoUnidade Int @default(0)

  maestrias         String @default("")
  habilidadesLegado String @default("")
  anotacoes         String @default("")

  arquivado    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  parametros    Parametro[]
  conhecimentos Conhecimento[]
  equipamentos  Equipamento[]
  habilidades   HabilidadeCaminho[]
  itens         ItemInventario[]
  recompensas   Recompensa[]
  combatentes   Combatente[]

  @@index([usuarioId])
}

model Parametro {
  id           String     @id @default(cuid())
  personagem   Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  personagemId String
  nome         String // um dos 8 fixos
  valor        Int        @default(0) // 0 a 6

  @@unique([personagemId, nome])
}

model Conhecimento {
  id           String     @id @default(cuid())
  personagem   Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  personagemId String
  nome         String // um dos 14 fixos
  valor        Int        @default(0) // 0 a 6
  temMaestria  Boolean    @default(false)

  @@unique([personagemId, nome])
}

enum TipoEquipamento {
  ARMA
  ARMADURA
}

model Equipamento {
  id           String          @id @default(cuid())
  personagem   Personagem      @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  personagemId String
  tipo         TipoEquipamento
  nome         String          @default("")
  dano         String          @default("") // armas
  alcance      String          @default("") // armas
  bloqueio     String          @default("") // armaduras / escudos
  inaptidao    String          @default("") // armaduras / escudos
  propriedade  String          @default("")
  ordem        Int             @default(0)

  @@index([personagemId])
}

enum TipoAcao {
  INICIATIVA
  ATIVA
  PASSIVA
  RAPIDA
  SIMPLES
  ACELERADA
}

model HabilidadeCaminho {
  id           String     @id @default(cuid())
  personagem   Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  personagemId String

  nome           String   @default("")
  tipoAcao       TipoAcao @default(ATIVA)
  custoPe        Int      @default(0)
  conjuracao     Boolean  @default(false)
  tipoConjuracao String   @default("")
  duracao        String   @default("")
  pagina         String   @default("")
  aprimoramentoA Boolean  @default(false)
  aprimoramentoB Boolean  @default(false)
  descricao      String   @default("")
  ordem          Int      @default(0)

  @@index([personagemId])
}

model ItemInventario {
  id           String     @id @default(cuid())
  personagem   Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  personagemId String
  nome         String     @default("")
  quantidade   Int        @default(1)
  peso         String     @default("")
  categoria    String     @default("")
  descricao    String     @default("")
  ordem        Int        @default(0)

  @@index([personagemId])
}

// ------------------------------------------------------------------ Criatura

enum CategoriaSer {
  COMUNS
  NAO_VIVOS
  ARTIFICIAIS
  FERAIS
  ELEMENTAIS
  ABISSAIS
  DO_VEU
  PRIMAIS
  CELESTIAIS
}

model Criatura {
  id          String       @id @default(cuid())
  nome        String
  nivel       Int          @default(1)
  poder       String       @default("")
  dificuldade String       @default("")
  categoria   CategoriaSer @default(COMUNS)

  parametrosOfensivos  String @default("")
  parametrosDefensivos String @default("")
  movimentacao         String @default("")
  percepcaoPassiva     String @default("")

  pvMax Int @default(0)
  peMax Int @default(0)

  caracteristicas String @default("") // tracos passivos, texto livre
  anotacoes       String @default("")

  arquivada    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  habilidades      HabilidadeCriatura[]
  combatentes      Combatente[]
  gruposIntegrante GrupoCombateIntegrante[]

  @@index([categoria])
}

// Acoes/poderes da criatura, organizadas em cards (mesmo formato de HabilidadeCaminho).
model HabilidadeCriatura {
  id         String   @id @default(cuid())
  criatura   Criatura @relation(fields: [criaturaId], references: [id], onDelete: Cascade)
  criaturaId String

  nome           String   @default("")
  tipoAcao       TipoAcao @default(ATIVA)
  custoPe        Int      @default(0)
  conjuracao     Boolean  @default(false)
  tipoConjuracao String   @default("")
  duracao        String   @default("")
  pagina         String   @default("")
  aprimoramentoA Boolean  @default(false)
  aprimoramentoB Boolean  @default(false)
  descricao      String   @default("")
  ordem          Int      @default(0)

  @@index([criaturaId])
}

// ------------------------------------------------------------------ Combate

model CombateAtivo {
  id              String   @id @default(cuid())
  nome            String   @default("Combate")
  rodadaAtual     Int      @default(1)
  turnoAtualIndex Int      @default(0)
  atualizadoEm    DateTime @updatedAt

  combatentes Combatente[]
}

enum TipoCombatente {
  PERSONAGEM
  CRIATURA
  AVULSO
}

model Combatente {
  id        String       @id @default(cuid())
  combate   CombateAtivo @relation(fields: [combateId], references: [id], onDelete: Cascade)
  combateId String

  tipo         TipoCombatente
  personagem   Personagem?    @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  personagemId String?
  criatura     Criatura?      @relation(fields: [criaturaId], references: [id], onDelete: SetNull)
  criaturaId   String?

  nomeExibicao    String
  valorIniciativa Int    @default(0)
  ordem           Int    @default(0)

  // Usados por criaturas e entradas avulsas. Combatentes do tipo PERSONAGEM
  // leem e gravam PV/PE direto na ficha do personagem.
  pvAtual Int @default(0)
  pvTemp  Int @default(0)
  pvMax   Int @default(0)
  peAtual Int @default(0)
  peTemp  Int @default(0)
  peMax   Int @default(0)

  anotacao String @default("")

  @@index([combateId])
}

// --------------------------------------------------------------- Recompensas

enum StatusRecompensa {
  PENDENTE
  ENTREGUE
}

model Recompensa {
  id         String @id @default(cuid())
  nome       String
  descricao  String @default("")
  categoria  String @default("")
  quantidade Int    @default(1)
  peso       String @default("")

  personagemDestino   Personagem? @relation(fields: [personagemDestinoId], references: [id], onDelete: SetNull)
  personagemDestinoId String?

  status     StatusRecompensa @default(PENDENTE)
  criadoEm   DateTime         @default(now())
  entregueEm DateTime?

  @@index([status])
}

// ---------------------------------------------------------- Notas de sessao

model AnotacaoSessao {
  id       String   @id @default(cuid())
  titulo   String
  data     DateTime @default(now())
  criadoEm DateTime @default(now())

  blocos BlocoSessao[]
  grupos GrupoCombate[]
}

// Bloco de anotacao dentro de uma sessao (substitui o campo de texto unico).
model BlocoSessao {
  id       String         @id @default(cuid())
  sessao   AnotacaoSessao @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  sessaoId String
  titulo   String         @default("")
  texto    String         @default("")
  ordem    Int            @default(0)

  @@index([sessaoId])
}

// Grupo de combate pre-montado na preparacao da sessao: um clique na
// Iniciativa adiciona todos os integrantes de uma vez.
model GrupoCombate {
  id        String          @id @default(cuid())
  sessao    AnotacaoSessao? @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  sessaoId  String?
  nome      String
  anotacoes String          @default("")
  ordem     Int             @default(0)

  integrantes GrupoCombateIntegrante[]

  @@index([sessaoId])
}

model GrupoCombateIntegrante {
  id      String       @id @default(cuid())
  grupo   GrupoCombate @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  grupoId String

  // ou referencia uma criatura do bestiario, ou e um NPC avulso (criaturaId nulo)
  criatura   Criatura? @relation(fields: [criaturaId], references: [id], onDelete: SetNull)
  criaturaId String?
  nomeAvulso String    @default("")
  pvAvulso   Int       @default(0)
  peAvulso   Int       @default(0)

  quantidade Int @default(1)
  ordem      Int @default(0)

  @@index([grupoId])
}

// ============================================================================
// Catalogos de referencia (importados do livro de regras — ver prisma/catalogos/).
// Somente o mestre cria/edita/exclui; jogador ve em modo leitura. Ficha e
// Criatura ainda nao referenciam estes catalogos (isso e a proxima fase, o
// "motor de efeitos") — por ora sao paginas de consulta e um alvo fixo para
// a marcacao de efeitos (grupo 0 da especificacao).

// Origem do arquivo taxonomia_caminhos_combate.csv — os 5 Caminhos e as 25
// Especializacoes, usados como filtro nas Habilidades e como referencia.
model EspecializacaoCombate {
  id                  String @id @default(cuid())
  caminho             String
  especializacao      String // "(base)" para a linha do proprio Caminho
  palavrasChave       String @default("")
  parametrosSugeridos String @default("")
  preRequisito        String @default("")
  descricaoResumo     String @default("")

  @@unique([caminho, especializacao])
}

// Origem do arquivo habilidades_personagem.csv (251 linhas).
model HabilidadeCatalogo {
  id             String  @id @default(cuid())
  caminho        String
  especializacao String // "(base)" ou uma das 25 especializacoes
  nome           String
  custoPe        String  @default("") // texto fiel a fonte: "2", "1-5", "X PV", "—"
  tipoAcao       String  @default("") // texto livre: valores reais nao batem com o enum TipoAcao
  conjuracao     Boolean @default(false)
  efeitoResumo   String  @default("")
  aprimoramentoA String  @default("")
  aprimoramentoB String  @default("")

  arquivada    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  efeitos EfeitoCatalogo[]

  @@index([caminho, especializacao])
}

// Origem do arquivo propriedades_armamentos.csv (15 linhas) — Afiado,
// Perfurar, Tambor etc. Referenciada por texto em Equipamento.propriedade
// (arma), nao por FK — evita reescrever o cadastro de equipamentos existente.
model PropriedadeArmamento {
  id           String @id @default(cuid())
  nome         String @unique
  efeitoResumo String @default("")
}

// Origem do arquivo equipamentos.csv (96 linhas) — armamentos, armaduras,
// vestuario, montarias, veiculos, itens, pocoes e toxinas.
model EquipamentoCatalogo {
  id                   String @id @default(cuid())
  categoria            String // Armadura, Armamento, Item Mundano, Item Utilizavel, Montaria, Pocao, Toxina, Vestuario, Veiculo
  subcategoria         String @default("")
  nome                 String
  precoMp              String @default("") // texto fiel a fonte: "18", "1000 (MO 2)", "—"
  unidade              String @default("") // peso de carga; idem, pode ser faixa ("6-20")
  danoOuBloqueio       String @default("")
  parametroOuRequisito String @default("")
  alcance              String @default("")
  propriedadeOuNotas   String @default("")

  arquivado    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([categoria])
}

// Origem do arquivo caracteristicas_criatura.csv (178 linhas) — os 9 "Livros
// dos Seres", usado no bestiario para montar criaturas.
model CaracteristicaCriaturaCatalogo {
  id           String @id @default(cuid())
  livro        String // Comuns, Nao-Vivos, Artificiais, Ferais, Elementais, Abissais, Do Veu, Primais, Celestiais
  dificuldade  String // Facil, Normal, Dificil, Extrema, Adicional, Tipo especial
  nome         String
  custoPe      String @default("")
  tipoAcao     String @default("")
  efeitoResumo String @default("")

  arquivada    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  efeitos EfeitoCatalogo[]

  @@index([livro, dificuldade])
}

enum GrupoEfeito {
  AUTOMATICO // bonus fixo, some direto nos totais da ficha/criatura
  ESCOLHA // bonus fixo mas o alvo e escolhido pelo jogador/mestre ao adicionar
  NARRATIVO // fica so como referencia (nome/custo/descricao) — a grande maioria
}

// Origem: item 0 e 5 da especificacao de Catalogos — a marcacao manual de
// quais habilidades/caracteristicas tem efeito automatizavel. Nasce vazia
// (nenhuma linha) ate a classificacao ser feita; ate la tudo se comporta
// como NARRATIVO (nada e somado automaticamente). "origem" distingue o
// efeito da propria habilidade dos efeitos de cada Aprimoramento.
model EfeitoCatalogo {
  id String @id @default(cuid())

  habilidade       HabilidadeCatalogo?             @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)
  habilidadeId     String?
  caracteristica   CaracteristicaCriaturaCatalogo? @relation(fields: [caracteristicaId], references: [id], onDelete: Cascade)
  caracteristicaId String?

  origem String @default("principal") // "principal" | "aprimoramentoA" | "aprimoramentoB"

  grupo        GrupoEfeito @default(NARRATIVO)
  alvoFixo     String? // ex.: "Vontade", "PV_max", "Bloqueio" — preenchido quando grupo = AUTOMATICO
  alvoOpcoes   String? // lista separada por virgula dos alvos validos, quando grupo = ESCOLHA
  valorFormula String? // numero ou formula simples, ex.: "1", "Poder*16", "Vigor/2"

  @@index([habilidadeId])
  @@index([caracteristicaId])
}
