# Supabase > Project Settings > Database > Connection string
# Transaction pooler (porta 6543) — usado pelo app em runtime
DATABASE_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler / conexao direta (porta 5432) — usado pelas migrations do Prisma
DIRECT_URL="postgresql://postgres.SEU_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo para assinar o cookie de sessao. Gere com:  openssl rand -base64 32
AUTH_SECRET="troque-isto-por-um-segredo-longo-e-aleatorio"

# Usados apenas pelo `npm run seed` para criar a conta do mestre
MESTRE_LOGIN="mestre"
MESTRE_SENHA="troque-esta-senha"
MESTRE_NOME="Mestre"
